[Unit]
Description=forgehand: GitHub Actions jobs on single-use VMs
Documentation=https://gitlab.com/dunn.dev/forgehand
After=network-online.target
Wants=network-online.target
# The failure breaker exits 1; stop restarting after five exits in ten minutes.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
ExecStart=/usr/local/bin/forgehand run -c /etc/forgehand/forgehand.toml
Restart=on-failure
RestartSec=5s

# SIGQUIT drains: idle runners go and running jobs finish before the daemon
# exits. systemd sends SIGKILL after TimeoutStopSec, so set it above the
# longest job you allow, or that job is killed mid-run.
KillSignal=SIGQUIT
# SIGQUIT must reach only the daemon; the plugin child survives the drain.
KillMode=mixed
TimeoutStopSec=6h30min

# The credentials appear under /run/credentials/forgehand.service/, readable
# only by this service. Point private_key_path (and key_path, if used) there.
LoadCredential=app.pem:/etc/forgehand/app.pem
# Uncomment together with use_static_credentials = true; the image trusts the matching public key.
#LoadCredential=guest-ssh:/etc/forgehand/guest-ssh

# The plugin runs as a child under these limits. If it needs a socket, device
# or path outside them, grant it with SupplementaryGroups= or ReadWritePaths=.
DynamicUser=yes
# The libvirt plugin needs the libvirt socket.
#SupplementaryGroups=libvirt
# Restart state for scale sets with use_static_credentials (STATE_DIRECTORY).
StateDirectory=forgehand
Environment=HOME=/var/lib/forgehand
Environment=FLEETING_PLUGIN_PATH=/usr/local/lib/fleeting/plugins
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/usr/local/lib/fleeting
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
