[Unit]
Description=forgehand: GitHub Actions jobs on single-use VMs
Documentation=https://gitlab.com/dunn.dev/forgehand
After=network-online.target
Wants=network-online.target
# The failure breaker exits 1; stop restarting after five exits in ten minutes.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
ExecStart=/usr/local/bin/forgehand run -c %h/.config/forgehand/forgehand.toml
Restart=on-failure
RestartSec=5s

# SIGQUIT drains: idle runners go and running jobs finish before the daemon
# exits. systemd sends SIGKILL after TimeoutStopSec, so set it above the
# longest job you allow, or that job is killed mid-run.
KillSignal=SIGQUIT
# SIGQUIT must reach only the daemon; the plugin child survives the drain.
# Upgrades use SIGUSR1 to the main process instead; see the README.
KillMode=mixed
TimeoutStopSec=6h30min

# Restart state for scale sets with use_static_credentials, in
# ~/.local/state/forgehand. The files hold the guest private key.
StateDirectory=forgehand
StateDirectoryMode=0700
UMask=0077
Environment=FLEETING_PLUGIN_PATH=/usr/local/lib/fleeting/plugins

# The plugin runs as a child under these limits. They need no namespaces, so
# they hold in a user manager whatever the host's user namespace policy.
NoNewPrivileges=yes
# Unix for the libvirt socket and the plugin's RPC socket; inet for GitHub,
# metrics and guest SSH.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=default.target
